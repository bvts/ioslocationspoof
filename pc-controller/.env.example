# ==============================================================================
# LocationControl Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' to configure your map and server settings:
# Example: copy .env.example .env
# ==============================================================================

# Map Provider: carto (default), openstreetmap, geoapify, mapbox, stadia
MAP_PROVIDER=carto

# Optional Map API Key (Geoapify, Mapbox, Stadia Maps)
MAP_API_KEY=

# Optional Custom Tile Layer URL
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# Simulation Persistence (true = keep spoofed coordinate on unplug/exit)
PERSIST_SIMULATION_ON_EXIT=true
