# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.env
.env.local
.env.*.local
.venv/
venv/
ENV/
env/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/
.tox/

# Swift / Xcode build artifacts
.build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
Packages/
xcuserdata/

# Sensitive credentials & certificates (never commit!)
*.p12
*.pem
*.cer
*.crt
*.mobileprovision
*.key

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temp files
*.log
*.tmp
