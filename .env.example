# ==============================================================================
# LocationControl Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' in this directory or in pc-controller/
# Example: copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Map Provider & API Key Configuration
# ------------------------------------------------------------------------------
# Provider options:
#   - carto         : Free high-contrast dark tiles (Default, no key required)
#   - openstreetmap : Standard OpenStreetMap tiles (Free, no key required)
#   - geoapify      : High-resolution dark & vector tiles (Requires free key at geoapify.com)
#   - mapbox        : Mapbox dark navigation tiles (Requires free key at mapbox.com)
#   - stadia        : Stadia Maps Alidade Smooth Dark (Requires free key at stadiamaps.com)
MAP_PROVIDER=carto

# Optional API Key for your chosen provider (Geoapify, Mapbox, Stadia Maps, etc.)
# If using 'carto' or 'openstreetmap', you can leave this blank.
MAP_API_KEY=

# Optional custom Tile Layer URL template (overrides MAP_PROVIDER if specified).
# Supports placeholders: {z}, {x}, {y}, {r}, and {apiKey}
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# ------------------------------------------------------------------------------
# Server Network Settings
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# ------------------------------------------------------------------------------
# Location Simulation Persistence
# ------------------------------------------------------------------------------
# If true, the iPhone holds the simulated GPS location even when the PC companion
# server closes or the USB cable is unplugged. If false, genuine GPS is restored on exit.
PERSIST_SIMULATION_ON_EXIT=true
